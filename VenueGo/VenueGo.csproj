    <Folder Include="Models\CheckinModels\" />
    <Folder Include="Models\OperationModels\" />
    <Folder Include="Models\ReservationModels\" />
    <Folder Include="Models\VenueModels\" />
    <Folder Include="wwwroot\images\icons\" />
    <Folder Include="wwwroot\images\logo\" />
