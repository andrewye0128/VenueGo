<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- 前台 Vue 專案所在資料夾（相對於此 .csproj） -->
    <SpaRoot>Front-Web\</SpaRoot>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(SpaRoot)node_modules\**;$(SpaRoot)dist\**</DefaultItemExcludes>
    <UserSecretsId>e6b7ebab-4d60-491d-a38b-5af9cb94721d</UserSecretsId>

    <!-- 開啟 XML 註解產出（讓 Scalar / Swagger 抓得到中文說明） -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 前端 Vue 專案防禦設定：防止 C# 編譯器誤掃描 Vue 產出的靜態檔案 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);$(SpaRoot)src\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- 前台 Vue 專案：不當成網站內容發佈，只在方案總管顯示原始碼 -->
  <ItemGroup>
   <Content Remove="$(SpaRoot)**" />
   <None Remove="$(SpaRoot)**" />
   <None Include="$(SpaRoot)**" Exclude="$(SpaRoot)node_modules\**;$(SpaRoot)dist\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Views\ReviewCardViewModel\**" />
    <Compile Remove="Views\ReviewCreateInputVM\**" />
    <Content Remove="Views\ReviewCardViewModel\**" />
    <Content Remove="Views\ReviewCreateInputVM\**" />
    <EmbeddedResource Remove="Views\ReviewCardViewModel\**" />
    <EmbeddedResource Remove="Views\ReviewCreateInputVM\**" />
    <None Remove="Views\ReviewCardViewModel\**" />
    <None Remove="Views\ReviewCreateInputVM\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Controllers\CReview1Controller.cs" />
    <Compile Remove="Services\Auth\CurrentUserService.cs" />
    <Compile Remove="Services\Auth\ICurrentUserService.cs" />
    <Compile Remove="Services\FakeCurrentUser.cs" />
    <Compile Remove="Services\HttpContextCurrentUser.cs" />
    <Compile Remove="Services\ICurrentUser.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.12" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\MemberModels\" />
    <Folder Include="Models\OperationModels\" />
    <Folder Include="Models\ReservationModels\" />
    <Folder Include="Models\VenueModels\" />
    <Folder Include="Mappers\" />
    <Folder Include="Models\TimeSlots\" />
    <Folder Include="Models\VenueModels\" />
    <Folder Include="ViewModels\VenueViewModels\" />
    <Folder Include="wwwroot\images\icons\" />
    <Folder Include="wwwroot\images\logo\" />
    <Folder Include="wwwroot\uploads\" />
  </ItemGroup>

  <ProjectExtensions><VisualStudio><UserProperties wwwroot_4lib_4bootstrap_4dist_4css_4bootstrap-grid_1css_1map__JsonSchema="" /></VisualStudio></ProjectExtensions>

  <ItemGroup>
    <EditorConfigFiles Remove=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".editorconfig" />
  </ItemGroup>

</Project>
