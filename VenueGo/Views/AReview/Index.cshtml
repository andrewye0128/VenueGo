@model VenueGo.ViewModels.ReviewViewModels.ReviewQueueVM
@using VenueGo.Models.ReviewModels
@using VenueGo.ViewModels.ReviewViewModels   @* 10/26 新增：QueueTab（封存數字的腳本） *@

@*
    放置路徑：Views/AReview/Index.cshtml
    使用預設的後台版型 _Layout.cshtml。

    這一頁只放「不會跟著清單變的東西」：
      標題、訊息區、標記垃圾的 modal、樣式、腳本。
      10/23 多了：回覆預覽的 modal（樣式在 wwwroot/css/site.css 最後面，10/25 搬過去集中管理）。
    會變的部分（搜尋列、篩選列、清單）全部在 _QueueList.cshtml。
*@

@{
      ViewData["Title"] = "評論管理";
}

@* 給置頂按鈕用的防偽 token（回覆表單自己會帶，不用這個） *@
@Html.AntiForgeryToken()

<h1 class="h4 mb-3">評論管理</h1>

@* 操作結果提示，由 JS 放進來 *@
<div id="queueFlash" aria-live="polite"></div>

@* 10/26：封存的數字只要點開過封存清單一次，這個分頁就不再顯示，關掉分頁重開才會再出現。
   跟換頁 Bar 的收合狀態一樣存在 sessionStorage（areview-pager.js），狀態掛在 <html> 的 data-spam-count-seen 上，
   數字藏起來的樣式在 site.css。清單被整塊換掉時，新的數字也會照著藏起來，不必重新套用。
   這段寫在清單前面、不放進 Scripts：畫面畫出數字之前就先套上，才不會一載入先閃一下數字再消失。
   瀏覽器封鎖 sessionStorage 時：當成沒有紀錄，只在這次載入有效。 *@
<script>
      (function () {
            'use strict';
            const STORE_KEY = 'venuego.reviewQueue.spamCountSeen';
            const SEEN_ATTR = 'data-spam-count-seen';

            function markSeen() {
                  document.documentElement.setAttribute(SEEN_ATTR, '');
                  try { sessionStorage.setItem(STORE_KEY, '1'); } catch { /* 存不了就只在這次載入有效 */ }
            }

            let seen = false;
            try { seen = sessionStorage.getItem(STORE_KEY) === '1'; } catch { seen = false; }
            if (seen) document.documentElement.setAttribute(SEEN_ATTR, '');

            // 一開始就是封存清單（網址帶 tab=spam、按 F5）
            if (@Json.Serialize(Model.Tab == QueueTab.Spam)) markSeen();

            // 在頁面上切到封存清單：清單換掉之後 areview-queue.js 會發出 queue:rendered，看 #queueState 的 data-tab
            document.addEventListener('queue:rendered', function () {
                  const state = document.getElementById('queueState');
                  if (state && state.dataset.tab === '@QueueTab.Spam') markSeen();
            });

            // 10/29：自己標記了一則封存（數字變多），就把「看過了」清掉，封存的數字重新顯示；再點開封存清單一樣會藏起來。
            //        areview-queue.js 標記成功、重新載入清單之前發出 queue:spam-marked
            document.addEventListener('queue:spam-marked', function () {
                  document.documentElement.removeAttribute(SEEN_ATTR);
                  try { sessionStorage.removeItem(STORE_KEY); } catch { /* 存不了就只在這次載入有效 */ }
            });
      })();
</script>

@* 清單容器。data-list-url 讓 JS 知道要去哪裡拿新清單，
   網址由 Url.Action 產生，路由改了這裡會自動跟著改。 *@
<div id="queueRoot" data-list-url="@Url.Action("QueueList")">
      <partial name="_QueueList" model="Model" />
</div>

@* ── 標記垃圾確認 ─────────────────────────────────────
   整頁共用一個，放在 queueRoot 外面，重新載入清單時才不會被換掉。 *@
<div class="modal fade" id="spamModal" tabindex="-1" aria-labelledby="spamModalTitle" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                  <div class="modal-header">
                        <h5 class="modal-title" id="spamModalTitle">
                              @* 10/23：確認畫面時標題會換字，所以文字包一層 span 給 JS 換。原本：
                              <i class="bi bi-trash me-2"></i>標記為垃圾評論
                              *@
                              <i class="bi bi-trash me-2"></i><span id="spamModalTitleText">標記為垃圾評論</span>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
                  </div>
                  <div class="modal-body">
                        @* ── 10/23：視窗分成兩個畫面 ──
                           第 1 個畫面（#spamStepReason）選理由，按「確定標記」換到第 2 個畫面（#spamStepConfirm）再確認一次，
                           按「確定，標記為垃圾」才真的送出。標記之後不能復原，所以多給一次反悔的機會；
                           確認畫面只有「返回」和「確定」，不做別的事。按「返回」回到第 1 個畫面，選好的理由還在。
                           不另開第二個視窗：Bootstrap 不支援兩個 modal 疊在一起（背景遮罩、焦點都會亂）。 *@
                        <div id="spamStepReason">
                        @* 9/29：下拉選單改成單選清單，每個理由底下附上判斷標準（ReviewPolicy.SpamReasonInfos 的 StaffHint）。
                           下拉選單沒辦法在每個選項底下放說明，員工只看得到「謾罵」兩個字，
                           很難判斷一則激烈的負評到底算不算。
                           value 仍然是陣列索引，送到後端的內容跟原本一樣。 *@
                        <fieldset id="spamReasonList">
                              <legend class="form-label fs-6">理由</legend>
                              @for (int i = 0; i < ReviewPolicy.SpamReasonInfos.Length; i++)
                              {
                                    var info = ReviewPolicy.SpamReasonInfos[i];
                                    <div class="form-check mb-2">
                                          <input class="form-check-input" type="radio" name="spamReason"
                                                 id="spamReason-@i" value="@i" aria-describedby="spamReasonHint-@i">
                                          <label class="form-check-label" for="spamReason-@i">
                                                <span class="fw-semibold">@info.Label</span>
                                                <span id="spamReasonHint-@i" class="d-block small text-muted">@info.StaffHint</span>
                                          </label>
                                    </div>
                              }
                        </fieldset>
                        <div class="form-text">
                              標記後這則評論會強制不公開，也不能再回覆。<strong>此操作無法復原。</strong>
                        </div>
                        </div>
                        @* 第 2 個畫面：理由由 JS 放進 #spamConfirmReason *@
                        <div id="spamStepConfirm" class="d-none">
                              <p class="mb-2">理由：<span id="spamConfirmReason" class="badge rounded-pill text-bg-dark"></span></p>
                              <ul class="small mb-0 ps-3">
                                    <li>這則評論會強制不公開（評論專區不會顯示），也不能再回覆。</li>
                                    <li>顧客會在「我的評論」看到「這則評論未通過審核，已下架」和這個理由。</li>
                                    <li><strong>標記之後沒有辦法復原。</strong></li>
                              </ul>
                        </div>
                        <div id="spamError" class="text-danger small mt-2"></div>
                  </div>
                  <div class="modal-footer">
                        @* 10/23：第 1 個畫面用原本的「取消」「確定標記」（確定標記改成換到確認畫面，不送出）；
                           第 2 個畫面用「返回」「確定，標記為垃圾」。切換畫面時由 JS 換 d-none。原本的兩行沒有改。 *@
                        @* 10/29：跟回覆預覽一樣，兩顆按鈕各佔一半、佔滿整行。四顆放在同一個兩欄的格子裡，
                           JS 用 d-none 藏起來的那兩顆不佔格子，所以每個畫面都剛好是左右各一顆。原本：
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
                        <button type="button" class="btn btn-danger" id="spamConfirm">確定標記</button>
                        <button type="button" class="btn btn-outline-secondary d-none" id="spamBack">返回</button>
                        <button type="button" class="btn btn-danger d-none" id="spamFinal">確定，標記為垃圾</button>
                        *@
                        <div class="queue-modal-actions">
                              <button type="button" class="btn btn-outline-secondary py-2" data-bs-dismiss="modal">取消</button>
                              <button type="button" class="btn btn-danger py-2" id="spamConfirm">確定標記</button>
                              <button type="button" class="btn btn-outline-secondary py-2 d-none" id="spamBack">返回</button>
                              <button type="button" class="btn btn-danger py-2 d-none" id="spamFinal">確定，標記為垃圾</button>
                        </div>
                  </div>
            </div>
      </div>
</div>

@* ── 10/23 回覆預覽 ────────────────────────────────────
   按回覆表單的「預覽並送出」打開。內容由 JS 從那則評論的 <template class="js-preview-src"> 複製過來，
   送出回覆的按鈕只有這裡的「確定送出」一顆。
   - 點視窗外、按 Esc、按「返回修改」都會關掉，輸入框的內容保留，表單下方提示「回覆還沒送出」。
   - 送出中不能關（JS 攔 hide.bs.modal），免得員工以為取消了，其實已經送出。
   - 跟標記垃圾的視窗一樣放在 queueRoot 外面，重新載入清單時才不會被換掉。 *@
<div class="modal fade" id="replyPreviewModal" tabindex="-1" aria-labelledby="replyPreviewTitle" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
            <div class="modal-content">
                  <div class="modal-header">
                        <h5 class="modal-title" id="replyPreviewTitle">
                              <i class="bi bi-eye me-2"></i>送出前預覽
                        </h5>
                        @* 10/29：「送出後無法修改或刪除」從底部按鈕列移到標題右邊，按鈕列才能整行給兩顆按鈕 *@
                        <span class="small text-danger-emphasis ms-3">
                              <i class="bi bi-exclamation-circle"></i> 送出後無法修改或刪除
                        </span>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
                  </div>
                  <div class="modal-body">
                        <p class="small text-muted mb-2">顧客看到的樣子（示意，實際版面以顧客端為準）</p>
                        <div id="replyPreviewBody"></div>
                        <div id="replyPreviewError" class="text-danger small mt-2"></div>
                  </div>
                  <div class="modal-footer">
                        @* 10/29：兩顆按鈕各佔一半、佔滿整行，按鈕放大；提示文字移到標題右邊。原本：
                        <span class="small text-muted me-auto">送出後無法修改或刪除</span>
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">返回修改</button>
                        <button type="button" class="btn btn-primary" id="replyPreviewSend">
                              <i class="bi bi-send"></i> 確定送出
                        </button>
                        *@
                        <div class="queue-modal-actions">
                              <button type="button" class="btn btn-outline-secondary py-2" data-bs-dismiss="modal">返回修改</button>
                              <button type="button" class="btn btn-primary py-2" id="replyPreviewSend">
                                    <i class="bi bi-send"></i> 確定送出
                              </button>
                        </div>
                  </div>
            </div>
      </div>
</div>

@section Scripts {
      @* axios 版本請改成課堂上用的版本，並寫死，不要用 latest *@
      <script src="https://cdn.jsdelivr.net/npm/axios@@1.20.0/dist/axios.min.js"></script>
      @* <script src="https://unpkg.com/axios/dist/axios.min.js"></script> *@
      @* 10/23 分頁後台：換頁 Bar（分頁_1023 的說明要加的那 1 行，這份已經包含） *@
      <script src="~/js/areview-pager.js" asp-append-version="true"></script>
      <script src="~/js/areview-queue.js" asp-append-version="true"></script>
}
