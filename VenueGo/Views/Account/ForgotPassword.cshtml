@model VenueGo.ViewModels.MemberViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "忘記密碼";
    Layout = null; // 👈 加上這行，去除側邊欄與 Header！
}

<div class="container py-5" style="max-width: 450px;">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-3 text-center"><i class="bi bi-key me-2 text-primary"></i>忘記密碼</h4>
            <p class="text-muted small text-center mb-4">請輸入您的 Email，系統將為您生成密碼重置連結。</p>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success small mb-3">
                    @TempData["SuccessMessage"]
                </div>
            }

            @* 💡 開發測試顯示區域：無實體 Email 時，直接在畫面上印出重置連結 *@
            @if (TempData["DevResetLink"] != null)
            {
                <div class="alert alert-info border-info small mb-4">
                    <div class="fw-bold mb-1"><i class="bi bi-info-circle me-1"></i>[開發測試展示] 模擬信件內容：</div>
                    <div class="text-break mb-2">點擊以下連結前往重置密碼：</div>
                    <a href="@TempData["DevResetLink"]" class="btn btn-sm btn-primary text-wrap w-100">
                        點我重置密碼
                    </a>
                </div>
            }

            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-bold">Email 帳號</label>
                    <input asp-for="Email" class="form-control" placeholder="example@venuego.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold mb-3">發送重置連結</button>
                <div class="text-center">
                    <a asp-action="Login" class="text-secondary text-decoration-none small">
                        <i class="bi bi-arrow-left me-1"></i>返回登入頁面
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}