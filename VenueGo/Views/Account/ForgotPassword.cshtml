@model VenueGo.ViewModels.MemberViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "忘記密碼";
    Layout = null; // 不載入後台整體 Layout
}

<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VenueGo</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <style>
            body {
                background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            }

            .forgot-card {
                border: none;
                border-radius: 1rem;
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
                overflow: hidden;
                background: #ffffff;
            }

            .card-header-icon {
                width: 64px;
                height: 64px;
                background-color: rgba(13, 110, 253, 0.1);
                color: #0d6efd;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 1.25rem;
                font-size: 1.75rem;
            }

            .form-control:focus {
                box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
            }

            .btn-primary {
                border-radius: 0.5rem;
                transition: all 0.2s ease-in-out;
            }

                .btn-primary:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
                }
    </style>
</head>
<body>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">

                <div class="card forgot-card">
                    <div class="card-body p-4 p-sm-5">

                        <!-- 圖示與標題 -->
                        <div class="text-center">
                            <div class="card-header-icon">
                                <i class="bi bi-key-fill"></i>
                            </div>
                            <h4 class="fw-bold mb-2 text-dark">忘記密碼</h4>
                            <p class="text-muted small mb-4">
                                請輸入您的 Email，系統將為您生成密碼重置連結。
                            </p>
                        </div>

                        <!-- 成功訊息提示 -->
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show small mb-3" role="alert">
                                <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        <!-- 開發測試展示區塊（無實體發信服務時使用） -->
                        @if (TempData["DevResetLink"] != null)
                        {
                            <div class="alert alert-info border-info small mb-4">
                                <div class="fw-bold mb-1">
                                    <i class="bi bi-info-circle-fill me-1"></i>[開發測試展示] 模擬信件內容：
                                </div>
                                <div class="text-break mb-2 text-secondary">點擊以下連結前往重置密碼：</div>
                                <a href="@TempData["DevResetLink"]" class="btn btn-sm btn-primary text-wrap w-100 shadow-sm">
                                    <i class="bi bi-box-arrow-up-right me-1"></i>點我重置密碼
                                </a>
                            </div>
                        }

                        <!-- 表單本體 -->
                        <form asp-action="ForgotPassword" method="post">
                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show small mb-3" role="alert">
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>

                            <!-- Email 輸入框 -->
                            <div class="mb-4">
                                <label asp-for="Email" class="form-label fw-semibold text-secondary small">Email 帳號</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted">
                                        <i class="bi bi-envelope"></i>
                                    </span>
                                    <input asp-for="Email" class="form-control" type="email" placeholder="example@venuego.com" required />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- 提交按鈕 -->
                            <button type="submit" class="btn btn-primary w-100 py-2.5 fw-bold mb-3">
                                <i class="bi bi-send me-1"></i> 發送重置連結
                            </button>
                        </form>

                        <!-- 返回登入連結 -->
                        <div class="text-center pt-3 border-top">
                            <a asp-action="Login" class="text-decoration-none small text-muted">
                                <i class="bi bi-arrow-left me-1"></i> 返回登入頁面
                            </a>
                        </div>

                    </div>
                </div>

                <!-- 頁尾宣告 -->
                <div class="text-center mt-4">
                    <p class="text-muted small">&copy; @DateTime.Now.Year VenueGo 場地預約系統. All rights reserved.</p>
                </div>

            </div>
        </div>
    </div>

    <!-- JS 資源與表單驗證腳本 -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>