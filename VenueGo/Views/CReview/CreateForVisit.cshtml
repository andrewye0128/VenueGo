@model VenueGo.ViewModels.ReviewVM.ReviewCreateForVisitVM

@{
      ViewData["Title"] = "CreateForVisit";
}
<style>
    /* 修正：精準指定表單內的群組區塊，不影響外層佈局 */
    form .form-group {
        margin-top: 15px; /* 只推上下間距，左右留空 */
    }
    
</style>

<h1>顧客填寫評論頁</h1>

@* <h4>ReviewCreateForVisitVM</h4> *@
<hr />
<div class="row justify-content-center">
    <div class="col-md-6">
            <!-- 推薦：識別碼走網址，不進表單本體 -->
            <form id="reviewForm" asp-action="CreateForVisit" method="post" asp-route-token="@Model.QrToken" onsubmit="return confirm('確定要送出評論嗎？\n送出後無法修改呦')">
                  <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                  @if (Model.ContextPrimary != null)
                  {
                        <div class="border rounded p-3 mb-3">
                              <div class="fw-semibold">
                                    <i class="bi bi-geo-alt me-1"></i>@Model.ContextPrimary
                              </div>
                              <div class="small text-muted">@Model.ContextSecondary</div>
                        </div>
                  }

                  <input type="hidden" asp-for="ReviewPerVisitId" />

                  <div class="form-group">
                        <!-- 使用 DisplayName 顯示標題 -->
                        <label asp-for="StarRating" class="control-label d-block">@Html.DisplayNameFor(model => model.StarRating)</label>

                        <div class="star-input">
                              @for (byte i = 5; i >= 1; i--)
                              {
                                    <input type="radio" asp-for="StarRating" value="@i" id="star@(i)"
                                           checked="@(Model.StarRating == i)" />
                                    <label for="star@(i)"><i class="bi bi-star-fill"></i></label>
                              }
                        </div>
                        <span asp-validation-for="StarRating" class="text-danger"></span>
                  </div>

                  <div class="form-group">
                        <label asp-for="ReviewContent" class="control-label"></label>
                        <textarea asp-for="ReviewContent" class="form-control" rows="12"
                                  maxlength="1000"></textarea>
                        <div class="d-flex justify-content-end">
                              <small id="charCount" class="text-muted">0 / 1000</small>
                        </div>
                        <span asp-validation-for="ReviewContent" class="text-danger"></span>
                  </div>

            @* <div class="form-group">
                <label asp-for="ReviewContent" class="control-label"></label>
                <textarea asp-for="ReviewContent" class="form-control" rows="12"></textarea>
                <span asp-validation-for="ReviewContent" class="text-danger"></span>
            </div> *@

                  <!-- 欄位 1：場地設施 -->
                  <div class="form-group mb-3 d-inline-block me-2">
                        <input type="checkbox" class="btn-check" id="mv" asp-for="MentionsVenue" autocomplete="off">
                        <label class="btn btn-sm btn-outline-success rounded-pill px-3" for="mv">
                              <!-- 🌟 自動讀取 [DisplayName("提及場地")] -->
                              <i class="bi bi-hash"></i> @Html.DisplayNameFor(model => model.MentionsVenue)
                        </label>
                        <span asp-validation-for="MentionsVenue" class="text-danger d-block"></span>
                  </div>

                  <!-- 欄位 2：服務人員 -->
                  <div class="form-group mb-3 d-inline-block">
                        <input type="checkbox" class="btn-check" id="ms" asp-for="MentionsStaff" autocomplete="off">
                        <label class="btn btn-sm btn-outline-success rounded-pill px-3" for="ms">
                              <!-- 🌟 自動讀取 [DisplayName("提及服務")] -->
                              <i class="bi bi-hash"></i> @Html.DisplayNameFor(model => model.MentionsStaff)
                        </label>
                        <span asp-validation-for="MentionsStaff" class="text-danger d-block"></span>
                  </div>

                  <div class="col-md-6 mb-3">
                    <label asp-for="IsAnonymous" class="form-label fw-bold"></label>
                    <div class="form-check form-switch mt-2">
                        <input asp-for="IsAnonymous" class="form-check-input" type="checkbox"
                                id="toggleAnonymous" disabled="@(!Model.CanChooseAnonymous)" />                        
                        <label class="form-check-label" for="toggleAnonymous">是否匿名</label>
                    </div>
                        @if (!Model.CanChooseAnonymous)
                        {
                              <div class="form-text">未登入的評論一律匿名，系統會給你一個隨機暱稱。</div>
                        }
                    <span asp-validation-for="IsAnonymous" class="text-danger"></span>
                  </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="IsPublic" class="form-label fw-bold"></label>
                    <div class="form-check form-switch mt-2">
                        <input asp-for="IsPublic" class="form-check-input" type="checkbox" id="togglePublic" />
                        <label class="form-check-label" for="togglePublic">公開此評論</label>
                    </div>
                    <span asp-validation-for="IsPublic" class="text-danger"></span>
                </div>

            @* <div class="form-group">
                <label asp-for="IsAnonymous" class="control-label"></label>
                        <input asp-for="IsAnonymous" class="form-check-input" disabled />
                <span asp-validation-for="IsAnonymous" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="IsPublic" class="control-label"></label>
                <input asp-for="IsPublic" class="form-check-input" />
                <span asp-validation-for="IsPublic" class="text-danger"></span>
            </div> *@

            @* <div class="col-md-6 mb-3">
                <label asp-for="VenueName" class="form-label fw-bold"></label>
                <!-- 使用 form-control-plaintext 去除外框線，只留純文字外觀 -->
                <input asp-for="VenueName" class="form-control-plaintext border-bottom ps-2" readonly />
                <span asp-validation-for="VenueName" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="RentStartTime" class="form-label fw-bold"></label>
                <input asp-for="RentStartTime" class="form-control-plaintext border-bottom ps-2" readonly />
                <span asp-validation-for="RentStartTime" class="text-danger"></span>
            </div> *@

            <div class="form-group">
                <input type="submit" value="送出" class="btn btn-primary" />
                <button type="button" id="btnSaveDraft" class="btn btn-outline-secondary">
                        <i class="bi bi-floppy"></i> 儲存草稿
                </button>
                <div class="mt-2"><small id="draftTimeHint" class="text-muted"></small></div>
            </div>
<div>
      <a asp-action="Index" class="btn btn-outline-secondary">返回前頁</a>
</div>
        </form>
    </div>
</div>


            
@section Scripts {
      @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
      }

      <script>
            // ⚠️ 這段必須在 DraftBox.init 之前。
            // 草稿還原時會補發 input 事件，計數器要先掛上去才收得到。
            (function() {
                var box = document.querySelector('textarea[name="ReviewContent"]');
                var hint = document.getElementById('charCount');
                if (!box || !hint) return;

                function update() {
                    var n = box.value.length;
                    hint.textContent = n + ' / 1000';
                    hint.classList.toggle('text-danger', n >= 900);
                    hint.classList.toggle('text-muted', n < 900);
                }
                box.addEventListener('input', update);
                update();
            })();
      </script>

      <script src="~/js/draft-box.js" asp-append-version="true"></script>
      <script>
            DraftBox.init({
                key: 'review-draft:@Model.QrToken',
                form: '#reviewForm',
                fields: @Html.Raw(Model.CanChooseAnonymous
                                  ? "['StarRating','ReviewContent','MentionsVenue','MentionsStaff','IsAnonymous','IsPublic']"
                                  : "['StarRating','ReviewContent','MentionsVenue','MentionsStaff','IsPublic']"),
                saveButton: '#btnSaveDraft',
                timeHint: '#draftTimeHint'
            });
      </script>
}