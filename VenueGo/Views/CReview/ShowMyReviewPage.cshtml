            <dt class="col-sm-2">
                  @Html.DisplayNameFor(model => model.StarRating)
            </dt>
            <dd class="col-sm-10 mb-0">
                  <!-- 💡 mb-0 移除下方預設間距，維持視覺平衡 -->
                  <span class="star-view text-warning">
                        <!-- 💡 加上 text-warning 可以直接讓星星變成亮眼的黃色 -->
                        @for (int i = 1; i <= 5; i++)
                        {
                              <i class="@(i <= Model.StarRating ? "bi bi-star-fill" : "bi bi-star text-muted")"></i>
                        }
                  </span>
            </dd>
      </dl>
