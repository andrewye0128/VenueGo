@model VenueGo.ViewModels.ReviewVM.ReviewCardVM

@{
      ViewData["Title"] = "ShowPublicReview";
}
<style>
      /* ── 星等輸入控制項 ─────────────────────────────
           HTML 裡星星寫成 5→1 倒序，再用 row-reverse 翻回正常視覺順序，
           這樣 ~ 選擇器才能讓「滑過第3顆」同時點亮左邊的第1、2顆。 */
      .star-input {
            display: inline-flex;
            flex-direction: row-reverse;
            justify-content: flex-end;
            gap: .25rem;
            font-size: 1.9rem;
      }

            .star-input input {
                  position: absolute;
                  opacity: 0;
                  width: 0;
                  height: 0;
            }

            .star-input label {
                  color: #d6d8db;
                  cursor: pointer;
                  line-height: 1;
                  transition: color .12s;
            }

                  .star-input input:checked ~ label,
                  .star-input label:hover,
                  .star-input label:hover ~ label {
                        color: #f5a524;
                  }
            /* 鍵盤操作時要看得見焦點 */
            .star-input input:focus-visible + label {
                  outline: 2px solid #0d6efd;
                  outline-offset: 3px;
                  border-radius: 3px;
            }

</style>

<h1>做錯的ShowPublicReview</h1>

@* <h4>ReviewCardViewModel</h4> *@
<hr />
<div class="row">
