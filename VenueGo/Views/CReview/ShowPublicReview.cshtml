                              <input type="radio" id="s2" name="StarRating" value="2"><label for="s2"><i class="bi bi-star-fill"></i></label>
                              <input type="radio" id="s1" name="StarRating" value="1"><label for="s1"><i class="bi bi-star-fill"></i></label>
                        </div>
