@model VenueGo.ViewModels.ContentViewModels.NewsIndexViewModel
@using VenueGo.Models.ContentModels

@{
    ViewData["Title"] = "資訊刊登";
    //查詢、分頁、狀態文字都已經在 Controller/Factory 處理完成,這裡只負責顯示
}

<!-- 功能頁籤:最新消息、常見問題 -->
<partial name="_ContentTabs" />

@if (TempData["NewsSuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["NewsSuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["NewsErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["NewsErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- 標題 + 新增按鈕同一行，左右分靠 -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0 fw-bold">最新消息列表</h5>
    <a asp-action="NewsCreate" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>新增消息
    </a>
</div>

<!-- 分類頁籤 >> 「全部」不帶 category,其他頁籤帶分類代碼;切換頁籤一律回到第 1 頁 -->
<ul class="nav nav-pills mb-4">
    <li class="nav-item">
        <a class="nav-link @(Model.CurrentCategory == null ? "active" : "")" asp-action="NewsIndex">全部</a>
    </li>
    @foreach (var category in NewsCategoryOptions.All)
    {
        <li class="nav-item">
            <a class="nav-link @(Model.CurrentCategory == category.Key ? "active" : "")"
               asp-action="NewsIndex" asp-route-category="@category.Key">@category.Value</a>
        </li>
    }
</ul>

@if (Model.Cards.Count == 0)
{
    <p class="text-muted">目前沒有消息</p>
}

<!-- 消息圖卡列表 -->
<div class="d-flex flex-column gap-3 mb-4">
    @foreach (var card in Model.Cards)
    {
        <div class="card flex-row shadow-sm">
            @* 封面統一直式 4:5,跟前台一致 *@
            <img src="@card.ImagePath" alt="@card.Title"
                 class="rounded-start"
                 style="width: 120px; height: 150px; object-fit: cover;" />

            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="d-flex gap-2 mb-1">
                        @if (card.IsPinned)
                        {
                            <span class="badge text-bg-danger"><i class="bi bi-pin-angle-fill me-1"></i>置頂</span>
                        }
                        <span class="badge text-bg-primary">@card.CategoryName</span>
                        @* 狀態顏色:草稿灰、排程中黃、已發布綠 *@
                        <span class="badge @(card.StatusText == "草稿" ? "text-bg-secondary" : card.StatusText == "排程中" ? "text-bg-warning" : "text-bg-success")">@card.StatusText</span>
                    </div>
                    <h5 class="card-title mb-1">@card.Title</h5>
                    <p class="card-text text-muted small mb-0">
                        發布時間 @card.PublishedAt.ToString("yyyy/MM/dd HH:mm")
                        <span class="mx-2">|</span>
                        建立時間 @card.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                    </p>
                </div>

                <div class="d-flex gap-2">
                    <a asp-action="NewsEdit" asp-route-id="@card.NewsId"
                       class="btn btn-outline-secondary btn-sm">編輯</a>
                    @* 刪除用 POST 表單送出 >> 隱藏欄位名稱要跟 Controller 參數 NewsId 一致;form 標籤會自動加防偽 token *@
                    <form asp-action="NewsDelete" method="post" onsubmit="return confirm('確定要刪除這則消息嗎?')">
                        <input type="hidden" name="NewsId" value="@card.NewsId" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">刪除</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<!-- 換頁按鈕 >> 換頁時帶著目前的分類,才不會跳回「全部」 -->
@if (Model.TotalPages > 1)
{
    <nav aria-label="分頁導覽" class="mt-4">
        <ul class="pagination pagination-sm mb-0">

            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                @if (Model.HasPreviousPage)
                {
                    <a class="page-link" asp-action="NewsIndex" asp-route-category="@Model.CurrentCategory" asp-route-page="@(Model.CurrentPage - 1)">上一頁</a>
                }
                else
                {
                    <span class="page-link">上一頁</span>
                }
            </li>

            @for (int pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                bool isCurrentPage = pageNumber == Model.CurrentPage;

                <li class="page-item @(isCurrentPage ? "active" : "")">
                    @if (isCurrentPage)
                    {
                        <span class="page-link">@pageNumber</span>
                    }
                    else
                    {
                        <a class="page-link" asp-action="NewsIndex" asp-route-category="@Model.CurrentCategory" asp-route-page="@pageNumber">@pageNumber</a>
                    }
                </li>
            }

            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                @if (Model.HasNextPage)
                {
                    <a class="page-link" asp-action="NewsIndex" asp-route-category="@Model.CurrentCategory" asp-route-page="@(Model.CurrentPage + 1)">下一頁</a>
                }
                else
                {
                    <span class="page-link">下一頁</span>
                }
            </li>

        </ul>
    </nav>
}
