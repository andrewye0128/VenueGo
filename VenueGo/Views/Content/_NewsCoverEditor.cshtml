@model VenueGo.Models.ContentModels.CNewsWrap
@using VenueGo.Models.ContentModels
@* 公版底稿編輯器(新增、編輯頁共用),行為寫在 wwwroot/js/news-cover-editor.js *@
@* 版面跟「上傳圖片」一致:左邊操作、右邊封面預覽,各佔半欄 *@
@* 字級、顏色的選項清單來自 NewsCoverOptions(後端驗證用同一份) *@

<div class="row g-3">
    <div class="col-md-6">
        <label class="form-label fw-bold d-block">字級</label>
        <div class="btn-group mb-3" role="group" aria-label="字級">
            @foreach (var size in NewsCoverOptions.Sizes)
            {
                @* data-cover-size-px:畫布上的像素,JS 套用字級與轉換樣式 JSON 時使用 *@
                <button type="button" class="btn btn-outline-secondary"
                        data-cover-size="@size.Code" data-cover-size-px="@size.Pixels">@size.Name</button>
            }
        </div>

        <label class="form-label fw-bold d-block">文字顏色</label>
        <div class="d-flex flex-wrap gap-2 mb-3">
            @foreach (var color in NewsCoverOptions.Colors)
            {
                @* 只顯示色票;顏色名稱放在 title(滑鼠移上去提示)與 aria-label(螢幕閱讀器) *@
                <button type="button" class="btn btn-outline-secondary p-1" data-cover-color="@color.Key"
                        title="@color.Value" aria-label="@color.Value">
                    <span class="d-block rounded-circle"
                          style="width: 24px; height: 24px; background-color: @color.Key;"></span>
                </button>
            }
        </div>

        <button type="button" id="newsCoverClearStyle" class="btn btn-outline-secondary btn-sm mb-2">
            <i class="bi bi-eraser me-1"></i>清除選取文字的樣式
        </button>
        <div class="form-text mb-1">先在畫布上反白要調整的文字,再按字級或顏色</div>
        <div id="newsCoverHint" class="text-danger small mb-3"></div>

        <div class="mb-3">內文字數:<span id="newsCoverCharCount">0 / @NewsCoverOptions.MaxTextLength</span></div>
        @* 後端驗證的錯誤(內文空白、超過字數、樣式或合成圖有誤) *@
        @Html.ValidationMessage("CoverText", null, new { @class = "text-danger small d-block mb-2" })
        <div id="newsCoverMessage"></div>

        <label class="form-label fw-bold d-block">列表圖卡預覽</label>
        <img id="newsCoverThumb" alt="封面縮圖預覽" class="rounded border"
             style="width: 150px; height: 188px; object-fit: cover;" />
        <div class="form-text">前台列表的圖卡大約這個大小</div>
    </div>
    <div class="col-md-6">
        <label class="form-label fw-bold">公告內容編輯</label>
        @* 畫布實際大小 1200 × 1500(輸出封面用),畫面上由 JS 縮小成 400 × 500 顯示 *@
        @* data-initial-text/styles:編輯頁原本的公版內容、或資料有誤退回時送出的內容 >> 載入時還原到畫布 *@
        <div>
            <div class="border rounded overflow-hidden d-inline-block">
                <canvas id="newsCoverCanvas" width="1200" height="1500"
                        data-template-url="@Url.Content("~/images/news/templates/cover-base.png")"
                        data-max-length="@NewsCoverOptions.MaxTextLength"
                        data-default-size="@NewsCoverOptions.DefaultSize"
                        data-default-color="@NewsCoverOptions.DefaultColor"
                        data-initial-text="@Model.CoverText"
                        data-initial-styles="@Model.CoverTextStyles"></canvas>
            </div>
        </div>
        <div class="form-text">點畫布的白色區域開始輸入內文;標題會自動帶入分類名稱</div>
    </div>
</div>

@* 送出時由 JS 填入(只有選公版底稿時才有值);不用 asp-for,值一律以 JS 填的為準 *@
<input type="hidden" name="CoverText" id="newsCoverTextInput" />
<input type="hidden" name="CoverTextStyles" id="newsCoverStylesInput" />
<input type="hidden" name="CoverImageData" id="newsCoverImageInput" />
