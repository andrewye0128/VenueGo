@model VenueGo.ViewModels.MemberViewModels.UserListViewModel

@{
    ViewData["Title"] = "會員帳號管理";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-people-fill text-primary me-2"></i>會員帳號管理</h4>
        <p class="text-muted small mb-0">檢視與管理所有具備「會員身分」之帳號、消費紀錄與狀態</p>
    </div>
    <div>
        <a asp-controller="Member" asp-action="ExportToCsv" class="btn btn-outline-success btn-sm">
            <i class="bi bi-file-earmark-excel me-1"></i>匯出會員 CSV
        </a>
    </div>
</div>

<!-- 提示訊息 -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show small" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show small" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- 搜尋與篩選卡片 -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form asp-controller="Member" asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="keyword" class="form-control" placeholder="搜尋姓名、Email、電話..." value="@Model.Keyword" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select form-select-sm">
                    <option value="">-- 所有帳號狀態 --</option>
                    <option value="Active" selected="@(Model.SelectedStatus == "Active")">啟用 (Active)</option>
                    <option value="Suspended" selected="@(Model.SelectedStatus == "Suspended")">停權 (Suspended)</option>
                    <option value="Inactive" selected="@(Model.SelectedStatus == "Inactive")">註銷 (Inactive)</option>
                </select>
            </div>
            <div class="col-md-4 text-end">
                <button type="submit" class="btn btn-primary btn-sm px-3">
                    <i class="bi bi-funnel me-1"></i>篩選
                </button>
                <a asp-controller="Member" asp-action="Index" class="btn btn-outline-secondary btn-sm ms-1">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>重置
                </a>
            </div>
        </form>
    </div>
</div>

<!-- 會員列表表格 -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">會員姓名</th>
                        <th>Email / 帳號</th>
                        <th>聯絡電話</th>
                        <th>角色</th>
                        <th>帳號狀態</th>
                        <th>註冊時間</th>
                        <th class="text-end pe-3">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Users != null && Model.Users.Any())
                    {
                        @foreach (var user in Model.Users)
                        {
                            bool isLocked = user.LockedUntil.HasValue && user.LockedUntil.Value > DateTime.Now;
                            <tr>
                                <td class="ps-3 fw-bold">
                                    <i class="bi bi-person-circle text-secondary me-2"></i>@user.Name
                                </td>
                                <td>@user.Email</td>
                                <td>@user.Phone</td>
                                <td>
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">Member</span>
                                </td>
                                <td>
                                    @if (isLocked)
                                    {
                                        <span class="badge bg-danger text-white border border-danger">
                                            <i class="bi bi-lock-fill me-1"></i>密碼錯鎖定
                                        </span>
                                    }
                                    else
                                    {
                                        @switch (user.Status)
                                        {
                                            case "Active":
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">正常啟用</span>
                                                break;
                                            case "Suspended":
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">已停權</span>
                                                break;
                                            case "Inactive":
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">已註銷</span>
                                                break;
                                            default:
                                                <span class="badge bg-light text-dark">@user.Status</span>
                                                break;
                                        }
                                    }
                                </td>
                                <td class="small text-muted">@user.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <!-- 檢視詳情按鈕（Manager 與 Admin 皆可使用） -->
                                        <button type="button" class="btn btn-outline-info" onclick="openDetailModal(@user.UserId)" title="檢視詳細資料與消費紀錄">
                                            <i class="bi bi-eye"></i> 詳情
                                        </button>

                                        <!-- 🔒 限制：僅限 Admin 才能看到的管理操作 -->
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <!-- 根據是否已具備員工身分判斷顯示按鈕 -->
                                            @if (user.IsEmployee)
                                            {
                                                <a asp-controller="Setting" asp-action="EditUser" asp-route-id="@user.UserId"
                                                   class="btn btn-outline-secondary" title="該使用者已是員工，點擊前往後台編輯權限與職稱">
                                                    <i class="bi bi-gear me-1"></i>員工設定
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-controller="Member" asp-action="ConvertToEmployee" asp-route-id="@user.UserId"
                                                   class="btn btn-outline-primary" title="將此會員升格為後台員工">
                                                    <i class="bi bi-person-badge me-1"></i>轉為員工
                                                </a>
                                            }

                                            <!-- 下拉選單：狀態與密碼管理 -->
                                            <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                                狀態與密碼
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm small">
                                                @if (isLocked)
                                                {
                                                    <li>
                                                        <form asp-controller="Member" asp-action="UnlockAccount" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="userId" value="@user.UserId" />
                                                            <button type="submit" class="dropdown-item text-primary fw-bold">
                                                                <i class="bi bi-unlock-fill me-2"></i>解鎖帳號 (密碼錯鎖定)
                                                            </button>
                                                        </form>
                                                    </li>
                                                    <li><hr class="dropdown-divider"></li>
                                                }

                                                @if (user.Status != "Active")
                                                {
                                                    <li>
                                                        <form asp-controller="Member" asp-action="UpdateMemberStatus" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="userId" value="@user.UserId" />
                                                            <input type="hidden" name="status" value="Active" />
                                                            <button type="submit" class="dropdown-item text-success">
                                                                <i class="bi bi-check-circle me-2"></i>設為 正常啟用
                                                            </button>
                                                        </form>
                                                    </li>
                                                }
                                                @if (user.Status != "Suspended")
                                                {
                                                    <li>
                                                        <form asp-controller="Member" asp-action="UpdateMemberStatus" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="userId" value="@user.UserId" />
                                                            <input type="hidden" name="status" value="Suspended" />
                                                            <button type="submit" class="dropdown-item text-danger">
                                                                <i class="bi bi-slash-circle me-2"></i>設為 帳號停權
                                                            </button>
                                                        </form>
                                                    </li>
                                                }

                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <form asp-controller="Member" asp-action="ResetMemberPassword" method="post" onsubmit="return confirm('確定要將此會員的密碼重置為預設密碼 Pass@1234 嗎？');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="userId" value="@user.UserId" />
                                                        <button type="submit" class="dropdown-item text-warning">
                                                            <i class="bi bi-key me-2"></i>重置密碼 (Pass@1234)
                                                        </button>
                                                    </form>
                                                </li>
                                            </ul>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>查無符合條件的會員資料
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- 分頁導覽區塊 -->
<div class="d-flex justify-content-between align-items-center mt-3 px-2">
    <!-- 左側：筆數統計資訊 (永遠顯示) -->
    <div class="text-muted small">
        @if (Model.TotalCount > 0)
        {
            <span>顯示第 <strong>@(((Model.CurrentPage - 1) * 10) + 1)</strong> 至 <strong>@(Math.Min(Model.CurrentPage * 10, Model.TotalCount))</strong> 筆，共 <strong>@Model.TotalCount</strong> 筆資料</span>
        }
        else
        {
            <span>共 <strong>0</strong> 筆資料</span>
        }
    </div>

    <!-- 右側：頁碼控制按鈕 (當總頁數大於 1 時才顯示) -->
    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination pagination-sm mb-0">
                <!-- 上一頁 -->
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-controller="Member" asp-action="Index"
                       asp-route-keyword="@Model.Keyword"
                       asp-route-status="@Model.SelectedStatus"
                       asp-route-page="@(Model.CurrentPage - 1)">
                        <i class="bi bi-chevron-left"></i> 上一頁
                    </a>
                </li>

                <!-- 頁碼 -->
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-controller="Member" asp-action="Index"
                           asp-route-keyword="@Model.Keyword"
                           asp-route-status="@Model.SelectedStatus"
                           asp-route-page="@i">@i</a>
                    </li>
                }

                <!-- 下一頁 -->
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-controller="Member" asp-action="Index"
                       asp-route-keyword="@Model.Keyword"
                       asp-route-status="@Model.SelectedStatus"
                       asp-route-page="@(Model.CurrentPage + 1)">
                        下一頁 <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

<!-- 會員詳細資料彈窗 (Modal) -->
<div class="modal fade" id="memberDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold" id="modalTitle"><i class="bi bi-person-lines-fill me-2"></i>會員詳細資料</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center py-4 text-muted" id="modalLoading">
                    <div class="spinner-border text-primary mb-2" role="status"></div>
                    <div>資料載入中...</div>
                </div>
                <div id="modalContent" class="d-none">
                    <div class="row g-3">
                        <div class="col-6"><strong>會員姓名：</strong> <span id="mName"></span></div>
                        <div class="col-6"><strong>出生日期：</strong> <span id="mBirth"></span></div>
                        <div class="col-6"><strong>Email：</strong> <span id="mEmail"></span></div>
                        <div class="col-6"><strong>電話：</strong> <span id="mPhone"></span></div>
                        <div class="col-12"><hr class="my-2"></div>
                        <div class="col-4 text-center">
                            <div class="text-muted small">累計消費</div>
                            <div class="fw-bold text-success fs-5">NT$ <span id="mConsumption"></span></div>
                        </div>
                        <div class="col-4 text-center">
                            <div class="text-muted small">預約次數</div>
                            <div class="fw-bold text-primary fs-5"><span id="mVisit"></span> 次</div>
                        </div>
                        <div class="col-4 text-center">
                            <div class="text-muted small">爽約次數</div>
                            <div class="fw-bold text-danger fs-5"><span id="mNoShow"></span> 次</div>
                        </div>
                        <div class="col-12"><hr class="my-2"></div>
                        <div class="col-6"><strong>帳號狀態：</strong> <span id="mStatus"></span></div>
                        <div class="col-6"><strong>註冊時間：</strong> <span id="mCreated"></span></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openDetailModal(userId) {
            const modal = new bootstrap.Modal(document.getElementById('memberDetailModal'));
            document.getElementById('modalLoading').classList.remove('d-none');
            document.getElementById('modalContent').classList.add('d-none');
            modal.show();

            fetch(`/Member/GetDetailJson/${userId}`)
                .then(response => {
                    if (!response.ok) throw new Error('載入失敗');
                    return response.json();
                })
                .then(data => {
                    document.getElementById('mName').textContent = data.name;
                    document.getElementById('mBirth').textContent = data.birth;
                    document.getElementById('mEmail').textContent = data.email;
                    document.getElementById('mPhone').textContent = data.phone;
                    document.getElementById('mConsumption').textContent = data.cumulativeConsumption ? data.cumulativeConsumption.toLocaleString() : '0';
                    document.getElementById('mVisit').textContent = data.cumulativeVisitTime || '0';
                    document.getElementById('mNoShow').textContent = data.noShowCount || '0';
                    document.getElementById('mStatus').textContent = data.status;
                    document.getElementById('mCreated').textContent = data.createdAt;

                    document.getElementById('modalLoading').classList.add('d-none');
                    document.getElementById('modalContent').classList.remove('d-none');
                })
                .catch(err => {
                    alert('無法讀取該會員詳細資料');
                    modal.hide();
                });
        }
    </script>
}