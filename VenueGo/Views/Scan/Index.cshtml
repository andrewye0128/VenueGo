@model VenueGo.ViewModels.CheckinViewModels.ScanViewModel
@{
    ViewData["Title"] = "掃描驗票 - " + Model.VenueName;
}

@* scan.js 從這個容器的 data-* 讀設定；防偽 token 也放在裡面，送出驗票請求時要帶 *@
<div id="scanApp"
     data-verify-url="@Model.VerifyUrl"
     data-venue-id="@Model.VenueId"
     data-pause-ms="@Model.PauseMilliseconds">
    @Html.AntiForgeryToken()

    <div class="d-flex align-items-center mb-3">
        <h5 class="mb-0">掃描驗票<span class="text-primary ms-2">@Model.VenueName</span></h5>
        <span class="text-muted small ms-3">請會員開啟「我的票券 → 使用票券」，將 QR Code 對準鏡頭</span>
    </div>

    <div class="row g-3">

        @* ───────── 左：鏡頭與模式 ───────── *@
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body">

                    @* 入場 / 離場：QR 本身不分，由櫃台選 *@
                    <div class="btn-group w-100 mb-3" role="group" aria-label="掃描模式">
                        <input type="radio" class="btn-check" name="scanMode" id="modeIn" value="in"
                               autocomplete="off" checked="@(Model.DefaultMode == "in")">
                        <label class="btn btn-outline-success" for="modeIn">入場</label>

                        <input type="radio" class="btn-check" name="scanMode" id="modeOut" value="out"
                               autocomplete="off" checked="@(Model.DefaultMode == "out")">
                        <label class="btn btn-outline-secondary" for="modeOut">離場</label>
                    </div>

                    <div class="ratio ratio-4x3 bg-dark rounded overflow-hidden">
                        <video id="scanVideo" playsinline muted></video>
                    </div>

                    <div class="d-flex gap-2 align-items-center mt-3">
                        <select id="cameraSelect" class="form-select form-select-sm" aria-label="選擇鏡頭"></select>
                        <button type="button" id="btnPause" class="btn btn-sm btn-outline-secondary text-nowrap">暫停掃描</button>
                    </div>
                    <p id="cameraStatus" class="small text-muted mt-2 mb-0">準備開啟鏡頭…</p>
                </div>
            </div>
        </div>

        @* ───────── 右：掃描結果（顏色與內容由 scan.js 切換） ───────── *@
        <div class="col-lg-6">
            <div id="resultCard" class="card border-secondary h-100">
                <div class="card-body d-flex flex-column justify-content-center text-center" style="min-height: 20rem;">
                    <div id="resultIcon" class="display-4 mb-2">
                        <i class="bi bi-qr-code-scan text-secondary"></i>
                    </div>
                    <h4 id="resultTitle" class="mb-2">等待掃描</h4>
                    <div id="resultBody" class="text-muted">掃描結果會顯示在這裡</div>

                    @* 離場超時才會出現：連到超時結帳頁 *@
                    <a id="resultAction" href="#" class="btn btn-warning mt-3 d-none">前往結帳</a>
                </div>
            </div>
        </div>
    </div>

    @* ───────── 本頁最近掃描紀錄（只留在畫面上，重新整理就清空；完整紀錄看票券的「報到管理」） ───────── *@
    <div class="card mt-3">
        <div class="card-header">最近掃描紀錄</div>
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead>
                    <tr><th>時間</th><th>動作</th><th>票號</th><th>會員</th><th>結果</th></tr>
                </thead>
                <tbody id="historyBody">
                    <tr id="historyEmpty"><td colspan="5" class="text-center text-muted">尚無掃描紀錄</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/zxing/zxing-browser.min.js"></script>
    <script src="~/js/scan.js" asp-append-version="true"></script>
}