@model VenueGo.ViewModels.ConvertEmployeeViewModel

@{
    ViewData["Title"] = "將會員轉為員工";
}

<div class="mb-3">
    <a asp-action="UserList" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>返回清單
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-person-badge-fill me-2"></i>將會員轉換為員工</h5>
    </div>
    <div class="card-body">
        <form asp-action="ConvertToEmployee" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Name" />
            <input type="hidden" asp-for="Email" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

            <!-- 目標會員資訊展示 -->
            <div class="alert alert-info mb-4">
                <div class="row">
                    <div class="col-md-6"><strong>會員姓名：</strong> @Model.Name</div>
                    <div class="col-md-6"><strong>Email 帳號：</strong> @Model.Email</div>
                </div>
            </div>

            <h6 class="fw-bold mb-3 text-secondary"><i class="bi bi-briefcase me-1"></i>員工資訊填寫</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="EmployeeNo" class="form-label fw-bold">員工編號 <span class="text-danger">*</span></label>
                    <input asp-for="EmployeeNo" class="form-control bg-light" readonly />
                    <span asp-validation-for="EmployeeNo" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="JobTitle" class="form-label fw-bold">職稱</label>
                    <input asp-for="JobTitle" class="form-control" placeholder="例如：營運專員 / 場館客服" />
                    <span asp-validation-for="JobTitle" class="text-danger small"></span>
                </div>
            </div>

            <hr class="my-4" />

            <h6 class="fw-bold mb-3 text-secondary"><i class="bi bi-shield-check me-1"></i>指派員工角色</h6>
            <div class="row g-3 mb-4">
                @if (Model.AvailableRoles != null && Model.AvailableRoles.Any())
                {
                    @foreach (var role in Model.AvailableRoles)
                    {
                        <div class="col-md-3 col-sm-6">
                            <div class="card border-light-subtle bg-light">
                                <div class="card-body p-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="SelectedRoleIds" value="@role.RoleId" id="role_@role.RoleId" />
                                        <label class="form-check-label fw-bold" for="role_@role.RoleId">
                                            @role.RoleName
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="text-end border-top pt-3">
                <a asp-action="UserList" class="btn btn-light me-2">取消</a>
                <button type="submit" class="btn btn-success px-4">
                    <i class="bi bi-check-circle me-1"></i>確認轉換為員工
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}