@model VenueGo.ViewModels.RegisterUserViewModel

@{
    ViewData["Title"] = "新增帳號";
}

<div class="mb-3">
    <a asp-controller="Setting" asp-action="Roles" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>返回
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-person-plus-fill me-2 text-primary"></i>建立新使用者帳號</h5>
    </div>
    <div class="card-body">
        <form asp-controller="Setting" asp-action="CreateUser" method="post">
            @Html.AntiForgeryToken()

            <h6 class="fw-bold mb-3 text-secondary"><i class="bi bi-card-heading me-1"></i>基本資料</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label fw-bold">姓名 <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="例如：張小明" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-bold">Email (登入帳號) <span class="text-danger">*</span></label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="example@venuego.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label fw-bold">密碼 <span class="text-danger">*</span></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label fw-bold">確認密碼 <span class="text-danger">*</span></label>
                    <input asp-for="ConfirmPassword" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label fw-bold">連絡電話 <span class="text-danger">*</span></label>
                    <input asp-for="Phone" class="form-control" placeholder="0912345678" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Birth" class="form-label fw-bold">出生日期 <span class="text-danger">*</span></label>
                    <input asp-for="Birth" class="form-control" type="date" />
                    <span asp-validation-for="Birth" class="text-danger small"></span>
                </div>
            </div>

            <hr class="my-4" />

            <h6 class="fw-bold mb-3 text-secondary"><i class="bi bi-briefcase me-1"></i>員工資訊</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="EmployeeNo" class="form-label fw-bold">員工編號 (系統自動產生)</label>
                    <input asp-for="EmployeeNo" class="form-control bg-light" readonly />
                    <span asp-validation-for="EmployeeNo" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="JobTitle" class="form-label fw-bold">職稱</label>
                    <input asp-for="JobTitle" class="form-control" placeholder="例如：系統管理員 / 場館經理" />
                </div>
            </div>

            <hr class="my-4" />

            <h6 class="fw-bold mb-3 text-secondary"><i class="bi bi-shield-check me-1"></i>指派系統角色</h6>
            <div class="row g-3">
                @if (Model.AvailableRoles != null && Model.AvailableRoles.Any())
                {
                    @foreach (var role in Model.AvailableRoles)
                    {
                        <div class="col-md-3 col-sm-6">
                            <div class="card border-light-subtle bg-light">
                                <div class="card-body p-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="SelectedRoleIds" value="@role.RoleId" id="role_@role.RoleId" />
                                        <label class="form-check-label fw-bold" for="role_@role.RoleId">
                                            @role.RoleName
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="mt-4 pt-3 border-top text-end">
                <a asp-controller="Setting" asp-action="Roles" class="btn btn-light me-2">取消</a>
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-person-check me-1"></i>建立帳號
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}