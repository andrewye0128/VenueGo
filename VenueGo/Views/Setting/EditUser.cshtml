@model VenueGo.ViewModels.EditUserViewModel

@{
    ViewData["Title"] = "編輯員工帳號";
}

<!-- 頂部頁籤 -->
<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <a class="nav-link" asp-controller="Setting" asp-action="Roles">
            <i class="bi bi-shield-lock me-1"></i>角色權限管理
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link active fw-bold" asp-controller="Setting" asp-action="UserList">
            <i class="bi bi-people me-1"></i>員工帳號管理
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-controller="Setting" asp-action="CreateUser">
            <i class="bi bi-person-plus me-1"></i>新增員工帳號
        </a>
    </li>
</ul>

<div class="mb-3">
    <a asp-controller="Setting" asp-action="UserList" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>返回員工列表
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-person-gear me-2 text-primary"></i>編輯員工帳號資料</h5>
    </div>
    <div class="card-body">
        <form asp-controller="Setting" asp-action="EditUser" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="EmployeeNo" class="form-label fw-bold">員工編號</label>
                    <input asp-for="EmployeeNo" class="form-control bg-light" readonly />
                </div>
                <div class="col-md-6">
                    <label asp-for="JobTitle" class="form-label fw-bold">職稱 <span class="text-danger">*</span></label>
                    <input asp-for="JobTitle" class="form-control" placeholder="例如：系統管理員 / 場館專員" />
                    <span asp-validation-for="JobTitle" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label fw-bold">姓名 <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-bold">Email <span class="text-danger">*</span></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label fw-bold">聯絡電話</label>
                    <input asp-for="Phone" class="form-control" placeholder="0912345678" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Status" class="form-label fw-bold">帳號狀態 <span class="text-danger">*</span></label>
                    <select asp-for="Status" class="form-select">
                        <option value="Active">啟用中 (Active)</option>
                        <option value="Inactive">已停用 (Inactive)</option>
                    </select>
                </div>
            </div>

            <hr class="my-4" />

            <h6 class="fw-bold mb-3"><i class="bi bi-shield-check me-1"></i>重新指派角色權限</h6>
            <div class="row g-3">
                @if (Model.AvailableRoles != null && Model.AvailableRoles.Any())
                {
                    @foreach (var role in Model.AvailableRoles)
                    {
                        var isChecked = Model.SelectedRoleIds != null && Model.SelectedRoleIds.Contains(role.RoleId);
                        <div class="col-md-4 col-sm-6">
                            <div class="card h-100 border-light-subtle bg-light">
                                <div class="card-body p-3">
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="SelectedRoleIds"
                                               value="@role.RoleId"
                                               id="role_@role.RoleId"
                                        @(isChecked ? "checked" : "") />
                                        <label class="form-check-label fw-bold" for="role_@role.RoleId">
                                            @role.RoleName
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-muted">目前無可供指派的角色。</div>
                }
            </div>

            <div class="mt-4 pt-3 border-top text-end">
                <a asp-controller="Setting" asp-action="UserList" class="btn btn-light me-2">取消</a>
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-floppy me-1"></i>儲存變更
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}