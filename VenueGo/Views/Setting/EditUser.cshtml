<!-- 引進共用頁籤 -->
<partial name="_SettingTabs" />

<div class="mb-3">
    <a asp-controller="Setting" asp-action="UserList" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>返回帳號列表
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-person-gear me-2 text-primary"></i>編輯員工帳號資料</h5>
    </div>
    <div class="card-body">
        <form asp-controller="Setting" asp-action="EditUser" method="post" id="editUserForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />

            <!-- 錯誤總覽提示 -->
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="EmployeeNo" class="form-label fw-bold">員工編號</label>
                    <input asp-for="EmployeeNo" class="form-control bg-light" readonly />
                </div>
                <div class="col-md-6">
                    <label asp-for="JobTitle" class="form-label fw-bold">職稱 <span class="text-danger">*</span></label>
                    <input asp-for="JobTitle" class="form-control" placeholder="例如：系統管理員 / 場館專員" />
                    <span asp-validation-for="JobTitle" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label fw-bold">姓名 <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-bold">Email <span class="text-danger">*</span></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label fw-bold">聯絡電話</label>
                    <input asp-for="Phone" class="form-control" placeholder="0912345678" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>

                <!-- 員工狀態下拉選單 -->
                <div class="col-md-6">
                    <label asp-for="Status" class="form-label fw-bold">員工狀態 <span class="text-danger">*</span></label>
                    <select asp-for="Status" class="form-select" id="statusSelect">
                        <option value="Active">在職 (Active)</option>
                        <option value="OnLeave">留職停薪 (On Leave)</option>
                        <option value="Resigned">離職 / 軟刪除 (Resigned)</option>
                    </select>
                    <div class="form-text text-muted" id="statusHelpText">
                        若設為「離職」，系統將自動移除後台管理角色，但會保留一般會員帳號權限。
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <h6 class="fw-bold mb-3"><i class="bi bi-shield-check me-1"></i>重新指派後台角色權限</h6>
            <div class="row g-3" id="rolesSection">
                @if (Model.AvailableRoles != null && Model.AvailableRoles.Any())
                {
                    @foreach (var role in Model.AvailableRoles)
                    {
                        var isChecked = Model.SelectedRoleIds != null && Model.SelectedRoleIds.Contains(role.RoleId);
                        <div class="col-md-4 col-sm-6">
                            <div class="card h-100 border-light-subtle bg-light">
                                <div class="card-body p-3">
                                    <div class="form-check">
                                        <input class="form-check-input role-checkbox"
                                               type="checkbox"
                                               name="SelectedRoleIds"
                                               value="@role.RoleId"
                                               id="role_@role.RoleId"
                                        @(isChecked ? "checked" : "") />
                                        <label class="form-check-label fw-bold" for="role_@role.RoleId">
                                            @role.RoleName
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-muted">目前無可供指派的角色。</div>
                }
            </div>

            <div class="mt-4 pt-3 border-top text-end">
                <a asp-controller="Setting" asp-action="UserList" class="btn btn-light me-2">取消</a>
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-floppy me-1"></i>儲存變更
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const statusSelect = document.getElementById('statusSelect');
            const form = document.getElementById('editUserForm');
            const roleCheckboxes = document.querySelectorAll('.role-checkbox');

            function handleStatusChange() {
                if (statusSelect.value === 'Resigned') {
                    roleCheckboxes.forEach(cb => {
                        cb.checked = false;
                        cb.disabled = true;
                    });
                } else {
                    roleCheckboxes.forEach(cb => {
                        cb.disabled = false;
                    });
                }
            }

            // 初始化與下拉選單異動監聽
            handleStatusChange();
            statusSelect.addEventListener('change', handleStatusChange);

            form.addEventListener('submit', function(e) {
                const selectedStatus = statusSelect.value;
                if (selectedStatus === 'Resigned') {
                    if (!confirm('警告：確定要將狀態設為「離職」嗎？\n此動作將自動取消該員工的所有後台權限，但會保留其前台會員帳號。')) {
                        e.preventDefault();
                    }
                }
            });
        });
    </script>
}