@*
    ReservationSummaryViewComponent 的預設檢視。
    五個步驟共用，資料由 ViewComponent 自 Session 取得，View 只負責呈現。

    圖示使用 Bootstrap Icons，請確認 _Layout.cshtml 已載入：
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
*@
@model VenueGo.ViewModels.Reservations.ReservationSummaryViewModel

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex align-items-center gap-2 py-3">
        <i class="bi bi-calendar-check text-primary"></i>
        <span class="fw-semibold">預約資訊摘要</span>
    </div>

    <div class="card-body">
        <dl class="summary-list mb-0">
            <div class="summary-row">
                <dt><i class="bi bi-person"></i>會員</dt>
                <dd>@Model.MemberText</dd>
            </div>
            <div class="summary-row">
                <dt><i class="bi bi-house"></i>場地</dt>
                <dd>@Model.VenueText</dd>
            </div>
            <div class="summary-row">
                <dt><i class="bi bi-calendar3"></i>日期</dt>
                <dd>@Model.DateText</dd>
            </div>
            <div class="summary-row">
                <dt><i class="bi bi-clock"></i>時段</dt>
                <dd>@Model.SlotText</dd>
            </div>

            @if (Model.PersonAmountText is not null)
            {
                <div class="summary-row">
                    <dt><i class="bi bi-people"></i>使用人數</dt>
                    <dd>@Model.PersonAmountText</dd>
                </div>
            }
        </dl>

        <hr class="my-3">

        <dl class="summary-list mb-0">
            <div class="summary-row">
                <dt><i class="bi bi-currency-dollar"></i>預估金額</dt>
                <dd>@Model.AmountText</dd>
            </div>
            <div class="summary-row">
                <dt><i class="bi bi-credit-card"></i>付款方式</dt>
                <dd>@Model.PaymentMethodText</dd>
            </div>
            <div class="summary-row">
                <dt><i class="bi bi-cash-coin"></i>付款狀態</dt>
                <dd><span class="badge text-bg-secondary-subtle text-secondary-emphasis">@Model.PaymentStatusText</span></dd>
            </div>

            @if (Model.InvoiceTypeText is not null)
            {
                <div class="summary-row">
                    <dt><i class="bi bi-receipt"></i>發票類型</dt>
                    <dd>@Model.InvoiceTypeText</dd>
                </div>
            }

            @if (Model.CarrierNoText is not null)
            {
                <div class="summary-row">
                    <dt><i class="bi bi-upc-scan"></i>載具號碼</dt>
                    <dd>@Model.CarrierNoText</dd>
                </div>
            }
        </dl>

        @if (!string.IsNullOrEmpty(Model.HintText))
        {
            <div class="alert alert-primary d-flex gap-2 mt-3 mb-0 py-2 px-3 small" role="status">
                <i class="bi bi-info-circle flex-shrink-0 mt-1"></i>
                <span>@Model.HintText</span>
            </div>
        }
    </div>
</div>

<style>
    .summary-list .summary-row {
        display: flex;
        align-items: baseline;
        gap: 1rem;
        padding: .375rem 0;
    }

    .summary-list dt {
        display: flex;
        align-items: center;
        gap: .5rem;
        flex: 0 0 7.5rem;
        font-weight: 400;
        color: var(--bs-secondary-color);
    }

    .summary-list dd {
        margin: 0;
        flex: 1 1 auto;
        min-width: 0;
        word-break: break-word;
    }
</style>
