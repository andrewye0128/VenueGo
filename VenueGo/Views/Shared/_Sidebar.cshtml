@*
    放置路徑：Views/Shared/_Sidebar.cshtml
    左側主選單。選單項目集中在下方 menus 陣列，新增子系統時只要加一筆。
*@
@using VenueGo.Helpers
@using VenueGo.Data
@using VenueGo.Models.Constants
@inject dbVenueContext Db
@{
    // 目前所在的 Controller，用來判斷選單要不要 active
    var current = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    // 擴充選單定義：新增 Roles 欄位，未指定或留空陣列表示所有人皆可看到
    var menus = new[]
    {
        new { Text = "儀表板",   Icon = "bi-house-door",       Controller = "Dashboard",   Action = "Index", Roles = new string[] { } },
        new { Text = "場地管理", Icon = "bi-buildings",        Controller = "Venue",       Action = "VenueIndex", Roles = RoleNames.BackOffice.Split(",") },
        new { Text = "預約管理", Icon = "bi-calendar-check",   Controller = "Reservation", Action = "Index", Roles = RoleNames.BackOffice.Split(",") },
        new { Text = "訂單管理", Icon = "bi-receipt",          Controller = "Order",       Action = "Index", Roles = RoleNames.BackOffice.Split(",") },
        new { Text = "會員管理", Icon = "bi-people",           Controller = "Member",      Action = "Index", Roles =  RoleNames.BackOffice.Split(",") },
        new { Text = "付款管理", Icon = "bi-credit-card",      Controller = "Payment",     Action = "Index", Roles = new string[] { } },
        new { Text = "票券管理", Icon = "bi-ticket-perforated", Controller = "Ticket",     Action = "Index", Roles = new string[] { } },
        // new { Text = "統計報表", Icon = "bi-bar-chart",        Controller = "Report",      Action = "Index", Roles = new string[] { } },
        new { Text = "統計報表", Icon = "bi-bar-chart",        Controller = "Analytics",   Action = "Index", Roles = RoleNames.ManagerOrAdmin.Split(",") },
        new { Text = "評論管理", Icon = "bi-chat-left-text",   Controller = "AReview",     Action = "Index", Roles = RoleNames.BackOffice.Split(",") },
        new { Text = "評論專區", Icon = "bi-chat-dots-fill",   Controller = "CReview",     Action = "Index", Roles = new string[] { } },
        // 🔒 限制：只有 Admin 角色可以看到「系統設定」
        new { Text = "系統設定", Icon = "bi-gear",             Controller = "Setting",     Action = "Index", Roles = new string[] {"Admin"} },
    };
}

<aside class="admin-sidebar" id="adminSidebar">

    <div class="sidebar-brand">
        <a class="brand" asp-controller="Dashboard" asp-action="Index">
            <span class="brand-mark"><i class="bi bi-buildings-fill"></i></span>
            <span class="brand-name">VenueGo</span>
        </a>
    </div>

    <nav class="sidebar-nav" aria-label="主選單">
        <ul>
            @foreach (var m in menus)
            {
                // 判斷權限：若沒有限制角色，或是目前登入使用者具備該角色，才予以渲染
                bool canView = m.Roles.Length == 0 || await AuthHelper.HasRoleAsync(User, Db, m.Roles);
                if (canView)
                {
                    var isActive = string.Equals(current, m.Controller, StringComparison.OrdinalIgnoreCase);
                    <li>
                        <a class="nav-item @(isActive ? "active" : "")"
                        asp-controller="@m.Controller" asp-action="@m.Action"
                        title="@m.Text">
                            <i class="bi @m.Icon"></i>
                            <span class="nav-text">@m.Text</span>
                        </a>
                    </li>
                }
            }
        </ul>
    </nav>

    <button type="button" class="sidebar-collapse" id="sidebarCollapse">
        <i class="bi bi-chevron-double-left"></i>
        <span class="nav-text">收合選單</span>
    </button>
</aside>
