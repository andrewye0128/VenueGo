@model VenueGo.ViewModels.CheckinViewModels.EntryTicketDetailViewModel
@{
    ViewData["Title"] = "票券詳情";
}

<partial name="_TicketHeader" model="Model" />
<partial name="_TicketTabs" model="Model.TicketId" />

<div class="border border-top-0 p-3">
    <div class="row">
        <div class="col-md-8">
            <dl class="row">
                <dt class="col-sm-2">場地</dt>
                <dd class="col-sm-10">@Model.VenueName (@Model.Location)</dd>
                <dt class="col-sm-2">日期</dt>
                <dd class="col-sm-10">@Model.BookingDate</dd>
                <dt class="col-sm-2">時段</dt>
                <dd class="col-sm-10">@Model.TimeRange</dd>
                <dt class="col-sm-2">QR Token</dt>
                <dd class="col-sm-10"><code>@Model.Qrtoken</code></dd>
            </dl>
        </div>
        <div class="col-md-4 text-center">
            <img src="@Url.Action("QrImage", new { id = Model.TicketId })"
                 alt="報到 QR Code" class="img-fluid border rounded p-2" style="max-width: 200px;" />
            <div class="text-muted small mt-2">請出示此 QR Code 供人員掃描</div>
        </div>
    </div>
</div>