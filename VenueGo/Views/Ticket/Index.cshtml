@model VenueGo.ViewModels.CheckinViewModels.TicketIndexViewModel

@{
    ViewData["Title"] = "今日票券";
    DateOnly todayDate = DateOnly.FromDateTime(DateTime.Now);
}

<div class="d-flex align-items-center gap-3 mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-person-badge me-2 text-primary"></i>票券清單</h4>
    <a asp-action="Index" asp-route-selectedDate="@todayDate.ToString("yyyy-MM-dd")" class="btn btn-outline-primary btn-sm">回到今天</a>
</div>

<!-- 搜尋與篩選區塊 -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-6 col-lg-3">
                <label class="form-label small fw-bold text-muted">日期</label>
                <div class="input-group">
                    <a asp-action="Index" asp-route-selectedDate="@Model.SelectedDate.AddDays(-1).ToString("yyyy-MM-dd")"
                       asp-route-txtKeyword="@Model.Keyword" asp-route-venueId="@Model.SelectedVenueId" asp-route-status="@Model.SelectedStatus"
                       class="btn btn-outline-secondary"><i class="bi bi-chevron-left"></i></a>
                    <input type="date" name="selectedDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                           class="form-control" onchange="this.form.submit()"/>
                    <a asp-action="Index" asp-route-selectedDate="@Model.SelectedDate.AddDays(1).ToString("yyyy-MM-dd")"
                       asp-route-txtKeyword="@Model.Keyword" asp-route-venueId="@Model.SelectedVenueId" asp-route-status="@Model.SelectedStatus"
                       class="btn btn-outline-secondary"><i class="bi bi-chevron-right"></i></a>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <label class="form-label small fw-bold text-muted">關鍵字搜尋</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="txtKeyword" value="@Model.Keyword" class="form-control" placeholder="會員姓名、電話或 QR Token..." />
                </div>
            </div>
            <div class="col-md-6 col-lg-2">
                <label class="form-label small fw-bold text-muted">依球館篩選</label>
                <select name="venueId" class="form-select" asp-items="Model.AvailableVenues">
                    <option value="">全部球館</option>
                </select>
            </div>
            <div class="col-md-6 col-lg-2">
                <label class="form-label small fw-bold text-muted">依狀態篩選</label>
                <select name="status" class="form-select">
                    <option value="">全部狀態</option>
                    <option value="1" selected="@(@Model.SelectedStatus == 1)">有效</option>
                    <option value="2" selected="@(Model.SelectedStatus == 2)">已使用</option>
                    <option value="3" selected="@(Model.SelectedStatus == 3)">已失效</option>
                    <option value="4" selected="@(Model.SelectedStatus == 4)">已取消</option>
                    <option value="5" selected="@(Model.SelectedStatus == 5)">已完成</option>
                </select>
            </div>
            <div class="col-lg-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary flex-fill">篩選</button>
                
                <a asp-action="Index" asp-route-selectedDate="@Model.SelectedDate.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">重置</a>
            </div>
        </form>
    </div>
</div>
<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>票券編號</th>
                <th>會員</th>
                <th>場地</th>
                <th>時段</th>
                <th>QR Token</th>
                <th>狀態</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Tickets.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">@Model.SelectedDate.ToString("yyyy/MM/dd") 查無符合條件的票券</td>
                </tr>

            }
            else
            {
                @foreach (var item in Model.Tickets)
                {
                    <tr class="@(item.IsCheckedIn ? "table-secondary" : "")">
                        <td>@item.TicketId</td>
                        <td>@item.UserName</td>
                        <td>@item.VenueName</td>
                        <td>@item.TimeRange</td>
                        <td><code class="small">@item.Qrtoken</code></td>
                        <td>
                            <span class="badge @(item.Status switch
                                  {
                                      1 => "bg-success",
                                      2 => "bg-secondary",
                                      3 => "bg-warning text-dark",
                                      4 => "bg-danger",
                                      5 => "bg-info text-dark",
                                      _ => "bg-dark"
                                  })">
                                @item.StatusText
                            </span>
                        </td>
                        <td class="text-nowrap">
                            @if (item.Status == 1 && DateTime.Now <= item.BookingDate.ToDateTime(item.EndTime))
                            {
                                <form asp-action="QuickCheckIn" asp-route-id="@item.TicketId" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-success">快速報到</button>
                                </form>
                            }
                            <a asp-action="Detail" asp-route-id="@item.TicketId" class="btn btn-sm btn-outline-primary">詳情</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
