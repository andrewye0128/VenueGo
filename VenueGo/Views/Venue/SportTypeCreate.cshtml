@model VenueGo.Models.VenueModels.CSportTypeWrap

@{
    ViewData["Title"] = "運動類型管理";
}

<div class="mb-3">
    <a asp-action="SportTypeIndex" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>返回列表
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2 text-primary"></i>運動類型新增</h5>
    </div>
    <div class="card-body">
        @* 有上傳檔案的表單一定要加 enctype="multipart/form-data",否則 PhotoFile 永遠收不到檔案 *@
        <form asp-action="SportTypeCreate" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

            <h6 class="fw-bold mb-3 text-secondary"><i class="bi bi-card-heading me-1"></i>基本資料</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="SportName" class="form-label fw-bold">運動類型名稱 <span class="text-danger">*</span></label>
                    <input asp-for="SportName" class="form-control" />
                    <span asp-validation-for="SportName" class="text-danger small"></span>
                </div>
            </div>

            <hr class="my-4" />

            @* 代表照片:前台「場館資訊」頁使用,跟個別場地的照片不同 *@
            <h6 class="fw-bold mb-3 text-secondary"><i class="bi bi-image me-1"></i>代表照片</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    @* CSportTypeWrap 沒有 PhotoFile 屬性,不能用 asp-for;name 要跟 Controller 參數 PhotoFile 一致 *@
                    <label for="PhotoFile" class="form-label fw-bold">上傳照片</label>
                    <input id="PhotoFile" name="PhotoFile" type="file" class="form-control" accept="image/*"
                           data-preview-target="photoPreview" />
                    <div class="form-text">顯示在前台「場館資訊」頁,可以不上傳</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">照片預覽</label>
                    <div>
                        <img id="photoPreview" src="" alt="代表照片預覽"
                             class="rounded" style="width: 180px; height: 130px; object-fit: cover;"
                             hidden />
                        <p id="photoPreviewEmptyText" class="text-muted mb-0">尚未上傳照片</p>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <h6 class="fw-bold mb-3 text-secondary"><i class="bi bi-exclamation-circle me-1"></i>注意事項</h6>
            <div class="mb-4">
                <label asp-for="Notice" class="form-label fw-bold">注意事項</label>
                <textarea asp-for="Notice" class="form-control" rows="8" maxlength="3000"></textarea>
                <div class="form-text">最多 3000 字;換行會保留,前台會照樣分段顯示</div>
                <span asp-validation-for="Notice" class="text-danger small"></span>
            </div>

            <div class="mt-4 pt-3 border-top text-end">
                <a asp-action="SportTypeIndex" class="btn btn-light me-2">取消</a>
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-check-lg me-1"></i>送出新增
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/photo-preview.js" asp-append-version="true"></script>
}
