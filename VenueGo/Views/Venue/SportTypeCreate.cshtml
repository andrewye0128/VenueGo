@model VenueGo.Models.VenueModels.CSportTypeWrap

@{
    ViewData["Title"] = "Create";
}

<h1>新增運動類型</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="SportTypeCreate">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="SportName" class="control-label"></label>
                <input asp-for="SportName" class="form-control" />
                <span asp-validation-for="SportName" class="text-danger"></span>
            </div>
           
            <div class="form-group">
                <input type="submit" value="送出新增" class="btn btn-primary mt-2" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="SportTypeIndex">取消新增</a>
</div>
