@model VenueGo.ViewModels.VenueViewModels.SportTypePriceRuleCreateViewModel

@{
    ViewData["Title"] = "價格規則管理";
}

<div class="mb-3">
    <a asp-action="SportTypePriceRuleIndex" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>返回列表
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-cash-coin me-2 text-primary"></i>新增價格規則</h5>
    </div>
    <div class="card-body">
        <form asp-action="SportTypePriceRuleCreate" method="POST">
            @Html.AntiForgeryToken()

            @* 只顯示不屬於任何欄位的錯誤,例如「有 N 天的尖峰起始時間需要修正」;各欄位的錯誤顯示在欄位下方 *@
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

            @* 區塊順序:基本資料 >> 每週尖峰時段 >> 價格(先決定哪幾天有尖峰,再填價格) *@
            <h6 class="fw-bold mb-3 text-secondary"><i class="bi bi-card-heading me-1"></i>基本資料</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="SportTypeId" class="form-label fw-bold">運動類型 <span class="text-danger">*</span></label>
                    <select asp-for="SportTypeId" asp-items="Model.SportTypes" class="form-select">
                        <option value="">請選擇運動類型</option>
                    </select>
                    <span asp-validation-for="SportTypeId" class="text-danger small"></span>
                    <div class="form-text">只列出還沒設定價格規則的運動類型</div>
                </div>
            </div>

            <h6 class="fw-bold mb-3 text-secondary"><i class="bi bi-calendar-week me-1"></i>每週尖峰時段</h6>
            <div class="mb-4">
                @* 7 列表格(週一~週日),每天的下拉選項依當天營業時間產生;新增時預設全部不分尖峰/離峰 *@
                <partial name="_SportTypePeakHoursTable" for="Days" />
            </div>

            <h6 class="fw-bold mb-3 text-secondary"><i class="bi bi-currency-dollar me-1"></i>價格</h6>
            <div class="row g-3 mb-2">
                <div class="col-md-6">
                    <label asp-for="OffPeakPrice" class="form-label fw-bold">離峰價格 <span class="text-danger">*</span></label>
                    <input asp-for="OffPeakPrice" type="number" min="0" class="form-control" />
                    <span asp-validation-for="OffPeakPrice" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PeakPrice" class="form-label fw-bold">尖峰價格 <span id="peakPriceRequiredMark" class="text-danger">*</span></label>
                    <input asp-for="PeakPrice" type="number" min="0" class="form-control" />
                    <span asp-validation-for="PeakPrice" class="text-danger small"></span>
                    @* 提示文字由 JS 依「是否有任何一天有尖峰」切換 *@
                    <div id="peakPriceHint" class="form-text"></div>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top text-end">
                <a asp-action="SportTypePriceRuleIndex" class="btn btn-light me-2">取消</a>
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-check-lg me-1"></i>送出新增
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @* 每週尖峰時段表格的畫面互動(即時說明、尖峰價格停用、全部不分尖峰/離峰按鈕) *@
    <script src="~/js/price-rule-peak-hours.js" asp-append-version="true"></script>
}
