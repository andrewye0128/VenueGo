@model VenueGo.ViewModels.VenueViewModels.VenueIndexViewModel
@using VenueGo.Helpers
@using VenueGo.Models.Constants
@using VenueGo.Data
@inject dbVenueContext Db

@{
    ViewData["Title"] = "場地管理";
    //分組跟換頁都已經在 Controller/Factory 那邊處理完成,這裡不用再自己組資料

    //是否有新增/編輯/刪除的權限,只有Admin跟Manager可以,Staff看得到列表但不能異動
    bool canManage = await AuthHelper.HasRoleAsync(User, Db, RoleNames.Admin, RoleNames.Manager);
}

<!-- 功能頁籤 -->
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "VenueIndex" || ViewContext.RouteData.Values["action"]?.ToString() == "VenueCreate" || ViewContext.RouteData.Values["action"]?.ToString() == "VenueEdit" ? "active" : "")"
           asp-controller="Venue" asp-action="VenueIndex">
            <i class="bi bi-geo-alt me-1"></i>場地管理
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "SportTypeIndex" || ViewContext.RouteData.Values["action"]?.ToString() == "SportTypeCreate" || ViewContext.RouteData.Values["action"]?.ToString() == "SportTypeEdit" ? "active" : "")"
           asp-controller="Venue" asp-action="SportTypeIndex">
            <i class="bi bi-tags me-1"></i>運動類型管理
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "SportTypePriceRuleIndex" || ViewContext.RouteData.Values["action"]?.ToString() == "SportTypePriceRuleCreate" || ViewContext.RouteData.Values["action"]?.ToString() == "SportTypePriceRuleEdit" ? "active" : "")"
           asp-controller="Venue" asp-action="SportTypePriceRuleIndex">
            <i class="bi bi-cash-coin me-1"></i>價格規則管理
        </a>
    </li>
    @if (canManage)
    {
        <li class="nav-item">
            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "WeekBusinessHourIndex" ? "active" : "")"
               asp-controller="Venue" asp-action="WeekBusinessHourIndex">
                <i class="bi bi-clock me-1"></i>營業時間管理
            </a>
        </li>
    }
</ul>

<!-- 標題 + 新增按鈕同一行，左右分靠 -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="mb-0 fw-bold">場地列表</h5>
    @if (canManage)
    {
        <a asp-action="VenueCreate" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>新增場地
        </a>
    }
</div>

<!-- 場地卡片列表 -->
@foreach (var group in Model.Groups)
{
    <h4 class="mt-4 mb-2">@group.SportTypeName</h4>
    <hr class="mt-0 mb-3" />

    <div class="d-flex flex-column gap-3 mb-4">
        @foreach (var item in group.Venues)
        {
            <div class="card flex-row shadow-sm">
                <img src="@item.PhotoPath" alt="@item.VenueName"
                     class="rounded-start"
                     style="width: 180px; height: 130px; object-fit: cover;" />

                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title mb-1">@item.VenueName</h5>
                        <p class="card-text text-muted mb-0">@item.Location</p>
                    </div>

                    <div class="d-flex align-items-center gap-4">
                        <span class="text-nowrap">容納 @item.Capacity 人</span>
                        <div class="d-flex gap-2">
                            <a asp-action="VenueUnavailableSlotManage" asp-route-venueId="@item.VenueId"
                               class="btn btn-outline-primary btn-sm">開放時間設定</a>
                            @if (canManage)
                            {
                                <a asp-action="VenueEdit" asp-route-id="@item.VenueId"
                                   class="btn btn-outline-secondary btn-sm">編輯</a>
                                <a asp-action="VenueDelete" asp-route-id="@item.VenueId"
                                   class="btn btn-outline-danger btn-sm" onclick="return confirm('確定要刪除該場地嗎?')">刪除</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- 換頁按鈕 >> 分頁單位是運動類型分組,不是場地本身,這個元件只有VenueIndex在用,直接寫在這裡不另外拆檔案 -->
@if (Model.TotalPages > 1)
{
    <nav aria-label="分頁導覽" class="mt-4">
        <ul class="pagination pagination-sm mb-0">

            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                @if (Model.HasPreviousPage)
                {
                    <a class="page-link" asp-action="VenueIndex" asp-route-page="@(Model.CurrentPage - 1)">上一頁</a>
                }
                else
                {
                    <span class="page-link">上一頁</span>
                }
            </li>

            @for (int pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                bool isCurrentPage = pageNumber == Model.CurrentPage;

                <li class="page-item @(isCurrentPage ? "active" : "")">
                    @if (isCurrentPage)
                    {
                        <span class="page-link">@pageNumber</span>
                    }
                    else
                    {
                        <a class="page-link" asp-action="VenueIndex" asp-route-page="@pageNumber">@pageNumber</a>
                    }
                </li>
            }

            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                @if (Model.HasNextPage)
                {
                    <a class="page-link" asp-action="VenueIndex" asp-route-page="@(Model.CurrentPage + 1)">下一頁</a>
                }
                else
                {
                    <span class="page-link">下一頁</span>
                }
            </li>

        </ul>
    </nav>
}