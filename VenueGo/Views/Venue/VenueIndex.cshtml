@model IEnumerable<VenueGo.Models.VenueModels.CVenueWrap>

@{
    ViewData["Title"] = "Index";
}

<h1>所有場地</h1>

<p>
    <a asp-action="VenueCreate" class="btn btn-primary btn-sm">新增場地</a>
    <a asp-action="SportTypeIndex" class="btn btn-primary btn-sm">運動類型管理</a>
</p>

<div class="d-flex flex-column gap-3">
    @foreach (var item in Model)
    {
        <div class="card flex-row shadow-sm">
            <img src="@item.PhotoPath" alt="@item.VenueName"
                 class="rounded-start"
                 style="width: 180px; height: 130px; object-fit: cover;" />

            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="card-title mb-1">@item.VenueName</h5>
                    <p class="card-text text-muted mb-0">@item.Location</p>
                </div>

                <div class="d-flex align-items-center gap-4">
                    <span class="text-nowrap">容納 @item.Capacity 人</span>
                    <div class="d-flex gap-2">
                        <a asp-action="VenueEdit" asp-route-id="@item.VenueId"
                           class="btn btn-outline-secondary btn-sm">編輯</a>
                        <a asp-action="VenueDelete" asp-route-id="@item.VenueId"
                           class="btn btn-outline-danger btn-sm">刪除</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>